[sub_resource type="GDScript" id="GDScript_1skun"]
script/source = "extends Polygon2D

var total_objects: int = 2  # Total linked objects (Set this in the Inspector)
var destroyed_objects: int = 0

func reduce_opacity():
	destroyed_objects += 1
	var new_alpha = 1.0 - (destroyed_objects / float(total_objects))  # Reduce opacity as objects are destroyed

	# Update the color of the Polygon2D (Polygon2D does not use modulate)
	var new_color = color
	new_color.a = new_alpha
	color = new_color  # Apply new transparency

	print(\"Mask opacity updated! New Alpha:\", new_alpha)

	# If all objects are destroyed, fade out completely
	if destroyed_objects >= total_objects:
		fade_out()

func fade_out():
	var tween = get_tree().create_tween()
	tween.tween_property(self, \"color:a\", 0.0, 1.0)  # Fade out over 1 second
	await tween.finished
	queue_free()  # Remove the mask
"

